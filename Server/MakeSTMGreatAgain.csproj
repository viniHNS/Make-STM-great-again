<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>MakeSTMGreatAgain</AssemblyName>
    <RootNamespace>MakeSTMGreatAgain</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>ViniHNS</Authors>
    <Company>ViniHNS</Company>
    <Product>Make STM Great Again</Product>
    <Description>A mod for SPT that improves the STM-9.</Description>
    <Copyright>Copyright © ViniHNS 2026</Copyright>
    <RepositoryUrl>https://github.com/viniHNS/Make-STM-great-again</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
  </ItemGroup>

  <!--
    The SPT server reads bundles.json + bundles/ from the mod folder and the mod reads config.json. The Web SDK
    already treats *.json as Content, so those use Update; *.bundle files are None.
  -->
  <ItemGroup>
    <Content Update="bundles.json;config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="bundles\**\*" CopyToOutputDirectory="PreserveNewest" />
    <ModDataFiles Include="bundles.json;config.json;bundles\**\*" />
  </ItemGroup>

  <PropertyGroup>
    <ModName>Make-STM-great-again</ModName>
    <SptModsDir>D:\Jogos\SPT4.1\SPT_Runtime\user\mods</SptModsDir>
  </PropertyGroup>

  <!-- Deploy to the local SPT install for testing. -->
  <Target Name="DeployToSpt" AfterTargets="Build" Condition="Exists('$(SptModsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptModsDir)\$(ModName)" />
    <Copy SourceFiles="@(ModDataFiles)" DestinationFiles="@(ModDataFiles->'$(SptModsDir)\$(ModName)\%(RelativeDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Text="--- Deployed server mod to $(SptModsDir)\$(ModName) ---" Importance="high" />
  </Target>

  <!-- Server-only mod: the zip contains SPT_Runtime\user\mods\<ModName>\ (DLL, bundles.json, bundles\). -->
  <Target Name="PackageModForDistribution" AfterTargets="Build">
    <PropertyGroup>
      <ZipFileName>$(ModName).zip</ZipFileName>
      <TempPackageDir>$(ProjectDir)obj\Package</TempPackageDir>
      <ModPackageDir>$(TempPackageDir)\SPT_Runtime\user\mods\$(ModName)</ModPackageDir>
    </PropertyGroup>
    <Message Text="--- Starting Mod packaging for distribution ---" Importance="high" />
    <RemoveDir Directories="$(TempPackageDir)" />
    <MakeDir Directories="$(ModPackageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModPackageDir)" />
    <Copy SourceFiles="@(ModDataFiles)" DestinationFiles="@(ModDataFiles->'$(ModPackageDir)\%(RelativeDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(TempPackageDir)" DestinationFile="$(ProjectDir)..\$(ZipFileName)" Overwrite="true" />
    <RemoveDir Directories="$(TempPackageDir)" />
    <Message Text="--- Mod successfully packaged at: $(ProjectDir)..\$(ZipFileName) ---" Importance="high" />
  </Target>

</Project>
